#!/bin/sh
# FAST_MODE pre-push: verify only the apps touched by the pushed commits
# (see docs/FAST_MODE.md — the FULL gate runs in CI on merge + nightly).
set -e

changed_files() {
  base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
  if [ -z "$base" ]; then
    base="HEAD~1"
  fi
  git diff --name-only "${base}...HEAD" 2>/dev/null
}

changed_apps() {
  changed_files | grep -oE '^apps/[^/]+' | cut -d/ -f2 | sort -u
}

# Lint only changed files (not the entire codebase)
files="$(changed_files)"
if [ -n "$files" ]; then
  echo "$files" | xargs -r oxlint || true
fi

apps="$(changed_apps)"
if [ -z "$apps" ]; then
  echo "pre-push: no app changes — per-app gate skipped (full gate: npm run gate)"
  exit 0
fi

for app in $apps; do
  bash scripts/verify-app.sh "$app"
done
echo "pre-push: per-app gate passed for: $(echo $apps | tr '\n' ' ')"
