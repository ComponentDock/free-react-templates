{
  "name": "free-react-templates",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @free-react-templates/aurora",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @free-react-templates/aurora",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage.enabled=false",
    "test:watch": "vitest --coverage.enabled=false",
    "test:coverage": "vitest run",
    "knip": "knip",
    "fallow": "fallow audit --gate all && fallow health && fallow dead-code && fallow dupes",
    "spec:validate": "openspec validate --specs",
    "readme:status": "node scripts/update-readme-status.mjs",
    "deploy": "bash scripts/deploy-template.sh",
    "deploy:aurora": "bash scripts/deploy-template.sh aurora",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "surge": "^0.41.2",
    "vitest": "^4.1.10"
  }
}
